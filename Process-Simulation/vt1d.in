CONTACT name=gate n.poly
INTERFACE qf=0
MODELS cvt srh fermi bgn temp=300 print
METHOD newton trap

PROBE name="ns" n.conc x=0.0005 y=5e-06
PROBE name="ps" p.conc x=0.0005 y=5e-06

SOLVE init
SAVE outfile=mos1d_equilibrium.str
SOLVE vgate=-0.05
SOLVE name=gate vstep=-0.05 vfinal=-1.0

LOG outfile=mos1d_gate_sweep.log
SOLVE name=gate vgate=-1.0 vstep=0.005 vfinal=0.20
LOG off
SAVE outfile=mos1d_vg1.str

# ns probe is 0.005 nm inside Si to avoid dielectric-side interface sampling.
# Local reconstructed acceptor density: 8.99824159008e+17 cm-3.
EXTRACT init infile="mos1d_gate_sweep.log"
EXTRACT name="Vt_1D_ns_equals_NA_V" x.val from curve(v."gate",probe."ns") where y.val=8.99824159008e+17
EXTRACT name="ns_vs_vg" curve(v."gate",probe."ns") outfile="mos1d_ns_vs_vg.dat"

quit
